#!/usr/bin/env bash
set -euo pipefail

until [ -f "$XDG_RUNTIME_DIR/container-env" ]; do sleep 0.5; done
# shellcheck source=/dev/null
. "$XDG_RUNTIME_DIR/container-env"
until xdpyinfo >/dev/null 2>&1 && [ -S /run/shm/macos-vnc.sock ] \
    && [ -w /run/shm/macos-vnc.sock ]; do sleep 0.5; done

openbox --sm-disable &
manager=$!
trap 'kill "$manager" 2>/dev/null || true' EXIT
vncviewer -AutoSelect=0 -FullColor=1 -FullScreen=1 -PreferredEncoding=Raw \
    -ReconnectOnError=0 -Shared=1 /run/shm/macos-vnc.sock
